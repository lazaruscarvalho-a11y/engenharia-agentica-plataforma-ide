  "editor.tokenColorCustomizations": {
    "comments": "#AD8C5F",
    "keywords": "#FFAA00",
    "strings": "#FFCF80",
    "numbers": "#E6B779",
    "types": "#FFD48A",
    "functions": "#FFE0A3",
    "variables": "#FFB52E",
    "textMateRules": [
      {
        "scope": [
          "punctuation",
          "keyword.operator"
        ],
        "settings": {
          "foreground": "#BD985F"
        }
      },
      {
        "scope": [
          "markup.heading"
        ],
        "settings": {
          "foreground": "#FFAA00",
          "fontStyle": "bold"
        }
      },
      {
        "scope": [
          "markup.inline.raw",
          "markup.fenced_code.block"
        ],
        "settings": {
          "foreground": "#FFCF80"
        }
      }
    ]
  },
  "editor.semanticTokenColorCustomizations": {
    "enabled": true,
    "rules": {
      "class": "#FFD48A",
      "type": "#FFD48A",
      "interface": "#FFD48A",
      "enum": "#FFD48A",
      "typeParameter": "#FFD48A",
      "function": "#FFE0A3",
